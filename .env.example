# Copy this file to .env and fill in your credentials (never commit .env)

# Chartmetric — get your refresh token from app.chartmetric.com > Account > API
CHARTMETRIC_REFRESH_TOKEN=your_chartmetric_refresh_token_here

PORT=3000

# Sprout Social — get your bearer token from app.sproutsocial.com > Settings > API
SPROUT_TOKEN=your_sprout_bearer_token_here
SPROUT_CUSTOMER_ID=2447399
